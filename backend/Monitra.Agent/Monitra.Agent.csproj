<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      v0.2 architecture correction: this is now a per-user tray application, not a Windows
      Service. Services run in Session 0 and cannot show UI to a logged-in user - and this
      agent now needs to show interactive prompts (inactivity justification, break requests).
      See the Monitra Architecture Reference, §04 and §14, for the full reasoning.

      Also Windows-only by design, unchanged from v0.1: idle detection and foreground-window
      tracking are Win32 APIs with no cross-platform equivalent used here.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Monitra.Agent</AssemblyName>
    <RootNamespace>Monitra.Agent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Security.Cryptography.ProtectedData ships as part of the net10.0-windows
         targeting pack - no explicit PackageReference needed (dotnet build warns NU1510
         otherwise). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
